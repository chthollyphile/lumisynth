{
  "name": "lumisynth",
  "productName": "lumisynth",
  "private": true,
  "version": "0.1.2",
  "description": "把一首歌做成歌词 PV：上传音频和字幕，自动编排镜头，手动调整，导出视频",
  "author": {
    "name": "chthollyphile",
    "email": "chthollyphile@users.noreply.github.com"
  },
  "homepage": "https://github.com/chthollyphile/lumisynth",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit:watch": "vitest",
    "test:render": "playwright test --project=lumisynth",
    "cf:dev": "vite build && wrangler dev",
    "cf:deploy": "vite build && wrangler deploy",
    "baseline:update": "playwright test --project=upstream --update-snapshots",
    "baseline:kernel": "playwright test --project=lumisynth kernel.spec.ts --update-snapshots",
    "test:smoke": "vite build && playwright test -c playwright.smoke.config.ts",
    "electron:start": "vite build && electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder --publish never"
  },
  "build": {
    "appId": "top.izuna.lumisynth",
    "productName": "lumisynth",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "chthollyphile",
        "repo": "lumisynth"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.video",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    },
    "linux": {
      "target": [
        "tar.gz",
        "deb",
        "rpm"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "executableName": "lumisynth",
      "artifactName": "${name}-${version}-linux-${arch}.${ext}",
      "publish": {
        "provider": "github",
        "publishAutoUpdate": false
      },
      "desktop": {
        "entry": {
          "StartupWMClass": "lumisynth"
        }
      }
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@applemusic-like-lyrics/ttml": "^1.0.1",
    "@chenglou/pretext": "^0.0.9",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "dexie": "^4.4.6",
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "lucide-react": "^1.48.0",
    "mediabunny": "^1.60.0",
    "motion": "^13.4.6",
    "music-metadata": "^11.16.1",
    "pixi.js": "^8.21.0",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0",
    "zustand": "^5.0.15"
  }
}
